# Local secrets for Supabase Edge Functions (used by `supabase functions serve`).
# Copy this file to `.env` in this same folder and fill in your real key.
# `.env` is gitignored — never commit your real key.
#
# These are SERVER-side only. Never prefix an AI key with VITE_ and never put one
# in the frontend .env: every VITE_ variable is inlined into the JavaScript bundle
# at build time and is readable by anyone who opens the site.

# REQUIRED. Free Gemini API key — no credit card: https://aistudio.google.com/apikey
# Do NOT enable billing on that Google Cloud project: unlike most Google services,
# enabling billing removes the Gemini free tier from the project entirely.
GEMINI_API_KEY=

# OPTIONAL. Overrides the Gemini model id. Leave empty to use the default
# (gemini-2.5-flash — free tier: 10 RPM / 250 RPD ≈ 62 reports/day).
# Set to gemini-2.5-flash-lite for more headroom (15 RPM / 1,000 RPD ≈ 250 reports/day).
# This exists so a future model retirement is a config change, not a code change.
GEMINI_MODEL=

# OPTIONAL — PAID. Lovable's AI Gateway, billed against Lovable workspace credits.
# GEMINI_API_KEY always takes precedence. Lovable is never used as a silent
# fallback: it runs only when ALLOW_LOVABLE_AI=true is also set. Leave both empty
# for free-tier use.
LOVABLE_API_KEY=
ALLOW_LOVABLE_AI=
