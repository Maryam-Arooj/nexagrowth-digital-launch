# Local secrets for Supabase Edge Functions (used by `supabase functions serve`).
# Copy this file to `.env` in this same folder and fill in your real key.
# `.env` is gitignored — never commit your real key.

# Free Gemini API key — get one with no credit card at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed if you ever want to switch back to Lovable's paid AI Gateway instead.
# Leave empty for local/free-tier use — the app falls back to GEMINI_API_KEY automatically.
LOVABLE_API_KEY=
