# NexaGrowth backend configuration.
# Copy to `.env` in this same folder and fill in real values.
# `.env` is gitignored — NEVER commit it, and never paste a key into chat.
#
# Nothing here is ever sent to the browser. The React app only knows
# VITE_API_URL; every secret stays on this side of the API boundary.

# --- PostgreSQL (local) -----------------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Use the psycopg (v3) driver — psycopg2 has no wheels for Python 3.13.
# If your password contains @ : / or #, percent-encode it (@ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/nexagrowth

# --- Gemini (Phase 4) -------------------------------------------------------
# Free key, no credit card: https://aistudio.google.com/apikey
# Do NOT enable billing on that Google Cloud project — unlike most Google
# services, enabling billing removes the Gemini free tier from it entirely.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
# Leave blank to use the default. gemini-2.5-flash is closed to new users and 404s.
GEMINI_MODEL=

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call this API. The Vite dev server is 8080.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
