# Frontend env overrides (gitignored `.env.local` takes precedence over `.env`).
#
# The frontend needs exactly ONE value: the base URL of the local FastAPI backend.
# It is public by design — no key, no secret. The Gemini API key and the PostgreSQL
# credentials live only in `backend/.env`, server-side, and are never bundled here.
#
# NEVER add an AI key or a database password to this file or to `.env`: every
# VITE_-prefixed variable is inlined into the JavaScript bundle at build time and
# is readable by anyone who opens the site.

VITE_API_URL="http://localhost:8000"
