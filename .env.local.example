# Frontend env overrides for LOCAL Supabase (used instead of the live Lovable Cloud project).
# Copy this file to `.env.local` (gitignored) — Vite loads it automatically and it overrides `.env`.
#
# Values below are the Supabase CLI's standard local-dev defaults. After running
# `supabase start`, run `supabase status` and paste in the "API URL" and "anon key"
# it prints (they're normally identical to these defaults, but confirm).

VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIiwiZXhwIjoxOTgzODEyOTk2fQ.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
VITE_SUPABASE_PROJECT_ID="local"
